APP_NAME=Laravel
APP_ENV=local

# Keep empty - run php artisan key:generate
APP_KEY=

APP_DEBUG=true
APP_URL=http://localhost:8000


# Keep empty - add actual payment webhook secret in .env
PAYMENT_WEBHOOK_SECRET=


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Optional - uncomment only if using database maintenance mode
# APP_MAINTENANCE_STORE=database

# Optional - uncomment if multiple PHP CLI workers are required
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# PostgreSQL database configuration
DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=quickbite
# DB_USERNAME=postgres

# Keep empty - add your local PostgreSQL password in .env
# DB_PASSWORD=


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# QuickBite uses Laravel Reverb for real-time broadcasting
BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# QuickBite uses database cache
CACHE_STORE=database

# Optional - uncomment if a custom cache prefix is required
# CACHE_PREFIX=


MEMCACHED_HOST=127.0.0.1


# Redis configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1

# Keep null if local Redis has no password
REDIS_PASSWORD=null

REDIS_PORT=6379


# Local development mail - emails are written to Laravel logs
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# AWS configuration - leave empty for local setup unless AWS is used
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Vite application name
VITE_APP_NAME="${APP_NAME}"


# Laravel Reverb configuration
# Keep credentials empty - add actual values in .env
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Local Reverb server
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http


# Vite Reverb configuration - automatically uses the values above
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=